RDHS_SITE_URL=https://your-private-site.example.com
RDHS_INGEST_TOKEN=replace-with-a-long-random-token
# K8s/Node deployment settings:
# DEPLOY_TARGET=k8s
# RDHS_STORAGE=mysql
# MYSQL_HOST=172.31.114.194
# MYSQL_PORT=4302
# MYSQL_DATABASE=rdhs_report
# MYSQL_USER=rdhs_report
# MYSQL_PASSWORD=replace-with-a-database-password
# MYSQL_TLS=false
# Optional: set when run_periodic_report.py lives outside this repo.
# RDHS_WORKSPACE_ROOT=/absolute/path/to/rdhs-workspace
# Sync containers set these non-secret commands through Helm values:
# RDHS_MONTHLY_BASELINE_COMMAND=python3 /opt/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode monthly-baseline
# RDHS_MONTHLY_REPORT_COMMAND=python3 /opt/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode weekly
# RDHS_CURRENT_REPORT_COMMAND=python3 /opt/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode weekly
# Runner and CronJob use a disposable local output directory. Baselines and leases are stored by Web in MySQL.
# RDHS_OUTPUT_ROOT=/var/lib/rdhs-sync
# RDHS_REPORT_COMMAND_TIMEOUT_SECONDS=540
# RDHS_SYNC_LEASE_TTL_SECONDS=1800
# RDHS_OUTPUT_RETENTION_MONTHS=6

# Optional: called by POST /api/report/refresh to trigger current-month Meegle refresh.
# RDHS_REFRESH_WEBHOOK_URL=https://your-internal-runner.example.com/rdhs/refresh
# RDHS_REFRESH_WEBHOOK_TOKEN=replace-with-a-runner-token

# Local development example:
# RDHS_SITE_URL=http://localhost:3000
# RDHS_REFRESH_WEBHOOK_URL=http://127.0.0.1:8765/rdhs/refresh
