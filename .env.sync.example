RDHS_SITE_URL=https://your-private-site.example.com
RDHS_INGEST_TOKEN=replace-with-a-long-random-token
# Optional: set when run_periodic_report.py lives outside this repo.
# RDHS_WORKSPACE_ROOT=/absolute/path/to/rdhs-workspace
# The external workspace's monthly-baseline mode only saves the comparison
# baseline. The monthly synchronizer runs it with the following month's first
# day, then runs the uploadable weekly report with the previous month's last day.
# RDHS_MONTHLY_BASELINE_COMMAND=python3 /absolute/path/to/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode monthly-baseline
# RDHS_MONTHLY_REPORT_COMMAND=python3 /absolute/path/to/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode weekly
# RDHS_CURRENT_REPORT_COMMAND=python3 /absolute/path/to/rdhs-workspace/topics/rdhs-operations/run_periodic_report.py --mode weekly
# The Web refresh and CronJob restore required monthly baselines from MySQL;
# Kubernetes Pods can therefore use a disposable emptyDir for this directory.
# RDHS_OUTPUT_ROOT=/absolute/path/to/persistent/rdhs-sync
# Each Meegle report command is bounded; only date-named monthly output older
# than six calendar months is pruned after a successful upload.
# RDHS_REPORT_COMMAND_TIMEOUT_SECONDS=540
# RDHS_OUTPUT_RETENTION_MONTHS=6
# Optional override; must be Python 3.10 or newer.
# RDHS_PYTHON_BIN=/absolute/path/to/python3.11
