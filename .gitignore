# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/
__pycache__/
*.py[cod]

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sync.example
.dev.vars
.dev.vars.*

# vercel
.vercel

/dist/
/.wrangler/
/.pi/
/outputs/
/work/
/runtime/
/vendor/rdhs-workspace/topics/rdhs-operations/runtime/

# Helm release artifacts generated by charts/build-chart.sh
/charts/packages/
/charts/meegle-rdhs-report-*/

# Local kubelink-charts audit and repair artifacts
.kubelinks-chart-report.json
/charts/.kubelink-charts-backup/

# Local Helm overrides may contain temporary smoke-test credentials.
/charts/rdhs-report/values-*.local.yaml
