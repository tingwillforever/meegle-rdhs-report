{
  "name": "rdhs-operations-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "DEPLOY_TARGET=k8s node --env-file=.dev.vars node_modules/vinext/dist/cli.js dev",
    "dev:k8s": "DEPLOY_TARGET=k8s node --env-file=.dev.vars node_modules/vinext/dist/cli.js dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "npm run build && node scripts/export-static.mjs",
    "deploy:pages": "bash scripts/deploy-to-github-pages.sh",
    "serve:pages": "npx serve -s dist/static -l 8089",
    "build:k8s": "DEPLOY_TARGET=k8s vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:k8s": "DEPLOY_TARGET=k8s vinext start --hostname 0.0.0.0 --port 3000",
    "sync:last-month": "bash scripts/run-sync-job.sh monthly",
    "test": "npm run test:unit && npm run test:python && npm run test:render",
    "test:unit": "node --test tests/rdhs-domain.test.mjs tests/rdhs-http.test.mjs tests/rdhs-repository.test.mjs tests/rdhs-sqlite-repository.test.mjs tests/rdhs-storage.test.mjs tests/rdhs-runtime.test.mjs tests/rdhs-health.test.mjs tests/mysql-schema.test.mjs tests/mysql-repository.test.mjs tests/sync-state.test.mjs tests/internal-sync-routes.test.mjs tests/dashboard-interactions.test.mjs tests/automation-shell.test.mjs tests/local-runtime.test.mjs tests/dockerfiles.test.mjs tests/helm-chart.test.mjs",
    "test:python": "python3 -m unittest tests/test_rdhs_web_sync.py",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "python3 scripts/migrate-local-d1.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.23.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
